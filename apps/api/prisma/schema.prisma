generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  CONTADOR
  VIEWER
}

enum TaxRegime {
  ORDINARIO
  RST
}

enum ProductType {
  SERVICE
  PRODUCT
  DIGITAL
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CONVERTED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NcfType {
  B01
  B02
  B14
  B15
  B16
  E31
  E32
  E33
  E34
  E41
  E43
  E44
  E45
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  VOIDED
}

model User {
  id                   String            @id @default(cuid())
  email                String            @unique
  passwordHash         String
  firstName            String
  lastName             String
  passwordResetToken   String?
  passwordResetExpires DateTime?
  failedLoginAttempts  Int               @default(0)
  lockUntil            DateTime?
  hashedRefreshToken     String?
  isEmailVerified        Boolean           @default(false)
  emailVerificationToken String?
  createdAt              DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  companyRoles         UserCompanyRole[]
  JournalEntry         JournalEntry[]
  Invoice              Invoice[]
  Expense              Expense[]
  auditLogs            AuditLog[]
}

model Company {
  id               String            @id @default(cuid())
  name             String
  rnc              String            @unique
  tradeName        String?
  taxRegime        TaxRegime         @default(ORDINARIO)
  address          String?
  phone            String?
  email            String?
  lockDate         DateTime?         @db.Date
  // Multi-country & Module configuration fields
  country          String            @default("DO")   // ISO 3166-1 alpha-2: "DO", "US", "MX", "CO"...
  currency         String            @default("DOP")  // ISO 4217: "DOP", "USD", "MXN"...
  locale           String            @default("es-DO") // BCP 47 locale tag
  enabledModules   String[]          @default(["DR_FISCAL"]) // Activated system modules: DR_FISCAL, US_ACCOUNTING, LATAM, INTERNATIONAL
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  userRoles        UserCompanyRole[]
  accounts         Account[]
  journalEntries   JournalEntry[]
  ncfSequences     NcfSequence[]
  expenses         Expense[]
  invoices         Invoice[]
  contacts         Contact[]
  employees        Employee[]
  payrolls         Payroll[]
  bankTransactions BankTransaction[]
  taxFilings       TaxFiling[]
  products         Product[]
  quotations       Quotation[]
  auditLogs        AuditLog[]
  taxRates         TaxRate[]
}

model UserCompanyRole {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      UserRole
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

model Account {
  id               String             @id @default(cuid())
  companyId        String
  code             String
  name             String
  type             AccountType
  parentId         String?
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent           Account?           @relation("AccountHierarchy", fields: [parentId], references: [id])
  children         Account[]          @relation("AccountHierarchy")
  entryLines       JournalEntryLine[]
  bankTransactions BankTransaction[]

  @@unique([companyId, code])
}

model JournalEntry {
  id              String             @id @default(cuid())
  companyId       String
  date            DateTime           @db.Date
  description     String
  reference       String?
  status          JournalEntryStatus @default(DRAFT)
  createdByUserId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByUser   User?              @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  lines           JournalEntryLine[]
  expense         Expense?
  invoice         Invoice?
  payrolls        Payroll[]

  @@index([companyId, status])
  @@index([companyId, date])
  @@index([companyId, reference])
}

model Invoice {
  id              String        @id @default(cuid())
  companyId       String
  clientRnc       String
  clientName      String
  ncf             String
  ncfType         NcfType
  date            DateTime      @db.Date
  paymentDate     DateTime?     @db.Date
  amount          Decimal       @db.Decimal(18, 2)
  itbis           Decimal       @default(0) @db.Decimal(18, 2)
  paymentMethod   String
  journalEntryId  String?       @unique
  isVoided        Boolean       @default(false)
  itbisRetained   Decimal       @default(0) @db.Decimal(18, 2)
  isrRetained     Decimal       @default(0) @db.Decimal(18, 2)
  costOfGoodsSold Decimal?      @db.Decimal(18, 2)
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalEntry    JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdByUser   User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  lines           InvoiceLine[]
  quotation       Quotation?

  @@index([companyId, date])
  @@index([companyId, isVoided, date])
  @@index([companyId, ncf])
}

model Expense {
  id                 String        @id @default(cuid())
  companyId          String
  providerRnc        String
  providerName       String
  ncf                String
  expenseType        String
  date               DateTime      @db.Date
  paymentDate        DateTime?     @db.Date
  amount             Decimal       @db.Decimal(18, 2)
  itbis              Decimal       @default(0) @db.Decimal(18, 2)
  itbisRetained      Decimal       @default(0) @db.Decimal(18, 2)
  isrRetained        Decimal       @default(0) @db.Decimal(18, 2)
  paymentMethod      String
  journalEntryId     String?       @unique
  isVoided           Boolean       @default(false)
  isForeignPayment   Boolean       @default(false)
  foreignCountry     String?
  foreignTaxId       String?
  foreignPaymentType String?
  createdByUserId    String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  company            Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalEntry       JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdByUser      User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, date])
  @@index([companyId, isVoided, date])
  @@index([companyId, isForeignPayment])
  @@index([companyId, ncf])
}

model JournalEntryLine {
  id               String            @id @default(cuid())
  journalEntryId   String
  accountId        String
  debit            Decimal           @default(0) @db.Decimal(18, 2)
  credit           Decimal           @default(0) @db.Decimal(18, 2)
  description      String?
  journalEntry     JournalEntry      @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account          Account           @relation(fields: [accountId], references: [id])
  bankTransactions BankTransaction[]

  @@index([journalEntryId])
  @@index([accountId])
}

model NcfSequence {
  id        String   @id @default(cuid())
  companyId String
  type      NcfType
  prefix    String
  current   Int      @default(0)
  max       Int
  isActive  Boolean  @default(true)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type])
}

enum ContactType {
  CLIENT
  PROVIDER
  BOTH
}

model Contact {
  id        String      @id @default(cuid())
  companyId String
  rnc       String
  name      String
  type      ContactType @default(CLIENT)
  email     String?
  phone     String?
  address   String?
  isActive  Boolean     @default(true)
  taxId     String?     // Generic tax ID for non-RD companies (EIN for US, RFC for MX, NIT for CO...)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, rnc])
  @@index([companyId, name])
}

model Employee {
  id           String        @id @default(cuid())
  companyId    String
  cedula       String
  name         String
  salary       Decimal       @db.Decimal(18, 2)
  jobTitle     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payrollItems PayrollItem[]

  @@unique([companyId, cedula])
  @@index([companyId, name])
}

model Payroll {
  id             String        @id @default(cuid())
  companyId      String
  period         String // Format: YYYYMM (e.g., "202607")
  grossSalary    Decimal       @db.Decimal(18, 2)
  sfsEmployee    Decimal       @db.Decimal(18, 2)
  sfsEmployer    Decimal       @db.Decimal(18, 2)
  afpEmployee    Decimal       @db.Decimal(18, 2)
  afpEmployer    Decimal       @db.Decimal(18, 2)
  arlEmployer    Decimal       @db.Decimal(18, 2)
  isrDeduction   Decimal       @db.Decimal(18, 2)
  netSalary      Decimal       @db.Decimal(18, 2)
  journalEntryId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  items          PayrollItem[]

  @@unique([companyId, period])
}

model PayrollItem {
  id           String   @id @default(cuid())
  payrollId    String
  employeeId   String
  grossSalary  Decimal  @db.Decimal(18, 2)
  sfsEmployee  Decimal  @db.Decimal(18, 2)
  afpEmployee  Decimal  @db.Decimal(18, 2)
  isrDeduction Decimal  @db.Decimal(18, 2)
  netSalary    Decimal  @db.Decimal(18, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  payroll      Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employee     Employee @relation(fields: [employeeId], references: [id])
}

model BankTransaction {
  id                 String            @id @default(cuid())
  companyId          String
  accountId          String
  date               DateTime
  description        String
  amount             Decimal           @db.Decimal(18, 2)
  reference          String?
  reconciled         Boolean           @default(false)
  journalEntryLineId String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account            Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  journalEntryLine   JournalEntryLine? @relation(fields: [journalEntryLineId], references: [id])

  @@index([companyId, accountId, reconciled])
  @@index([companyId, accountId, date])
}

model TaxFiling {
  id              String   @id @default(cuid())
  companyId       String
  period          String // Formato: AAAAMM (ej: 202607)
  taxType         String // ej: 'IT1'
  salesAmount     Decimal  @db.Decimal(18, 2)
  salesItbis      Decimal  @db.Decimal(18, 2)
  purchasesAmount Decimal  @db.Decimal(18, 2)
  purchasesItbis  Decimal  @db.Decimal(18, 2)
  itbisToPay      Decimal  @db.Decimal(18, 2)
  status          String   @default("FILED")
  filedAt         DateTime @default(now())
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, period, taxType])
}

model TaxDocument {
  id        String             @id @default(cuid())
  title     String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  chunks    TaxDocumentChunk[]
}

model TaxDocumentChunk {
  id            String                     @id @default(cuid())
  taxDocumentId String
  content       String
  embedding     Unsupported("vector(768)")
  createdAt     DateTime                   @default(now())
  taxDocument   TaxDocument                @relation(fields: [taxDocumentId], references: [id], onDelete: Cascade)

  @@index([taxDocumentId])
}

model Product {
  id               String          @id @default(cuid())
  companyId        String
  code             String
  sku              String?
  name             String
  description      String?
  type             ProductType     @default(SERVICE)
  price            Decimal         @db.Decimal(18, 2)
  cost             Decimal?        @db.Decimal(18, 2)
  taxRate          Decimal         @default(18) @db.Decimal(5, 2)
  unit             String          @default("unidad")
  revenueAccountId String?
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceLines     InvoiceLine[]
  quotationLines   QuotationLine[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([companyId, code])
}

model Quotation {
  id          String          @id @default(cuid())
  companyId   String
  number      String
  clientRnc   String?
  clientName  String
  clientEmail String?
  status      QuotationStatus @default(DRAFT)
  validUntil  DateTime?       @db.Date
  notes       String?
  subtotal    Decimal         @db.Decimal(18, 2)
  itbis       Decimal         @default(0) @db.Decimal(18, 2)
  total       Decimal         @db.Decimal(18, 2)
  invoiceId   String?         @unique
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice     Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  lines       QuotationLine[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, createdAt])
}

model QuotationLine {
  id          String    @id @default(cuid())
  quotationId String
  productId   String?
  description String
  quantity    Decimal   @db.Decimal(10, 2)
  unitPrice   Decimal   @db.Decimal(18, 2)
  discount    Decimal   @default(0) @db.Decimal(5, 2)
  taxRate     Decimal   @default(18) @db.Decimal(5, 2)
  subtotal    Decimal   @db.Decimal(18, 2)
  itbis       Decimal   @default(0) @db.Decimal(18, 2)
  total       Decimal   @db.Decimal(18, 2)
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quotationId])
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(18, 2)
  discount    Decimal  @default(0) @db.Decimal(5, 2)
  taxRate     Decimal  @default(18) @db.Decimal(5, 2)
  cost        Decimal? @db.Decimal(18, 2)
  subtotal    Decimal  @db.Decimal(18, 2)
  itbis       Decimal  @default(0) @db.Decimal(18, 2)
  total       Decimal  @db.Decimal(18, 2)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String?
  userId    String?
  action    String
  entity    String
  entityId  String
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId])
}

model TaxRate {
  id          String   @id @default(cuid())
  companyId   String
  name        String   // "ITBIS", "Sales Tax NY", "IVA", "GST"
  code        String   // "ITBIS_18", "SALES_TAX_NY", "IVA_16"
  rate        Decimal  @db.Decimal(5, 4) // 0.1800, 0.0885, 0.1600
  taxType     String   // "VAT", "SALES_TAX", "RETENTION_ISR", "RETENTION_ITBIS"
  agency      String   // "DGII", "IRS", "SAT", "DIAN"
  appliesTo   String   // "SALE", "PURCHASE", "BOTH"
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([companyId, isActive])
}

