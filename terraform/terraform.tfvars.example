# Environment Selection (e.g. production, staging, development)
environment = "production"

# GitHub Settings
github_repo_url = "https://github.com/raulcaminero/cmhub"
github_branch   = "main"

# Supabase Project settings
supabase_project_ref = "rzumdrqyerlwdiftxzxb"
supabase_db_password = "your_supabase_database_password"

# Third-Party Integrations
gemini_api_key = "your_gemini_api_key_here"
